# Runtime mode: demo fixtures; api OpenAI STT; local_kz local Kazakh STT.
APP_MODE=demo

# Required in api and local_kz for downstream analysis. Never commit a real key.
OPENAI_API_KEY=your_openai_api_key_here

# Providers can be replaced by local/self-hosted implementations later.
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_DIARIZATION_MODEL=gpt-4o-transcribe-diarize
OPENAI_TEXT_MODEL=gpt-6-astra

# Optional LOCAL_KZ model. Weights are downloaded into the Hugging Face cache.
LOCAL_KZ_MODEL=shyngys879/kazakh-whisper-large-v3-turbo

# Backward-compatible switch used by the original transcription module.
# TRANSCRIPTION_MODE=demo
